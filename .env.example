# Dev local
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Produção (mesmo domínio do site, via Nginx)
# NEXT_PUBLIC_API_URL=https://finzup.com.br/api/v1

FRONTEND_PORT=3000

# Feature Método Finzup / Baby Steps
# Somente "true" habilita a navegação, jornada e cards relacionados.
NEXT_PUBLIC_ENABLE_BABY_STEPS=true

# Mixpanel (opcional em dev — deixe vazio para desabilitar)
# NEXT_PUBLIC_MIXPANEL_TOKEN=

# Stripe (obrigatório em produção para checkout customizado na /assinatura)
# Use a chave publicável (pk_test_... / pk_live_...) do mesmo account do backend
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google OAuth (mesmo Client ID do backend)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
