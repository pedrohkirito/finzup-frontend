# App
# Dev local
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Produção (mesmo domínio, via Nginx): https://finzup.com.br/api/v1
# Porta publicada pelo docker-compose
FRONTEND_PORT=3000

# Funcionalidades
# Somente "true" liga a navegação, a jornada e os cards do Método Finzup
NEXT_PUBLIC_ENABLE_BABY_STEPS=true

# Analytics (vazio desliga)
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_META_PIXEL_ID=

# Pagamento e login (mesmo Client ID e a mesma conta Stripe do backend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
